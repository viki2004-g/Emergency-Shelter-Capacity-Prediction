# ─── Flask ───────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret-key

# ─── MySQL Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shelter_system
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ─── Application Settings ─────────────────────────────────────────
# Safe occupancy planning limit (percentage of max capacity)
SAFE_OCCUPANCY_LIMIT_PCT=85

# Scoring weights (must sum to 1.0)
WEIGHT_DISTANCE=0.25
WEIGHT_CAPACITY=0.35
WEIGHT_FACILITIES=0.20
WEIGHT_RESOURCES=0.20

# Prediction: how many hours ahead to predict overload
PREDICT_HOURS_AHEAD=6
